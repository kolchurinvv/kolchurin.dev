{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel 2>/dev/null)\" 2>/dev/null && git add .claude/ 2>/dev/null; true",
            "if": "Bash(git commit*)"
          }
        ]
      }
    ]
  }
}
